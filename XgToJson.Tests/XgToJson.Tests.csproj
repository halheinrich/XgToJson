<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The one exception to the repo-wide policy in Directory.Build.props:
         test classes are not a consumed API, so a doc file buys nothing and
         CS1591 would only add noise. Warnings-as-errors still applies. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XgToJson\XgToJson.csproj" />
    <!-- Direct, not left transitive through the exe: the tests call the
         library themselves (XgFileBuilder / XgFileWriter to synthesize their
         input, XgFileReader to walk the corpus). -->
    <ProjectReference Include="..\..\ConvertXgToJson_Lib\ConvertXgToJson_Lib\ConvertXgToJson_Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
